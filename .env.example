# ── Django ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────
DB_NAME=school_db
DB_USER=school_user
DB_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# ── CORS & URLs ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://yourdomain.com,https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Email (Gmail SMTP) ───────────────────────────────────
EMAIL_HOST_USER=yourschool@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ── Frontend build ───────────────────────────────────────
# Leave as /api if frontend and backend are on the same domain
VITE_API_URL=/api

# ── School Identity ──────────────────────────────────────
# Used as prefix in admission numbers and employee IDs
SCHOOL_CODE=AAPHS

# ── Superuser (auto-created on first startup) ─────────────
DJANGO_SUPERUSER_USERNAME=superadmin
DJANGO_SUPERUSER_PASSWORD=Admin@12345
DJANGO_SUPERUSER_EMAIL=admin@school.com
